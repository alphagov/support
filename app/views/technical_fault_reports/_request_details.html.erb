<%= render "govuk_publishing_components/components/notice", {
  title: f.object.class.description
} %>

<div id="technical-fault-context">
  <%= render "govuk_publishing_components/components/radio", {
    heading: "What isn't working properly? (required)",
    heading_level: 0,
    name: name_for(f, %w[fault_context]),
    items: f.object.fault_context_options.map do |text, value|
      {
        id: "#{f.object_name}_fault_context_#{value}",
        value: value,
        text: text,
        checked: f.object.fault_context == value
      }
    end,
    error_items: errors_for(@request.errors, :fault_context)
  } %>
</div>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "How much is it affecting? (the whole thing, a specific feature or specific URLs) (required)"
  },
  name: name_for(f, %w[fault_specifics]),
  value: f.object.fault_specifics,
  rows: 6,
  error_items: errors_for(@request.errors, :fault_specifics)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "What were you trying to do? (required)"
  },
  name: name_for(f, %w[actions_leading_to_problem]),
  value: f.object.actions_leading_to_problem,
  rows: 6,
  error_items: errors_for(@request.errors, :actions_leading_to_problem)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "What happened? (required)"
  },
  name: name_for(f, %w[what_happened]),
  value: f.object.what_happened,
  rows: 6,
  error_items: errors_for(@request.errors, :what_happened)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "What should have happened? (required)"
  },
  name: name_for(f, %w[what_should_have_happened]),
  value: f.object.what_should_have_happened,
  rows: 6,
  error_items: errors_for(@request.errors, :what_should_have_happened)
} %>

<%= render "govuk_publishing_components/components/notice", {
  title: "If you have screenshots please send them as attachments in reply to the acknowledgement email you will receive shortly."
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<%= hidden_field_tag "use_design_system", true %>

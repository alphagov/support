<%= content_for :page_title, "Anonymous Feedback" %>
<%= content_for :header, "Feedback" %>

<% breadcrumb :feedex %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "At the bottom of every page on GOV.UK we ask, “is there anything wrong with this page?”. Users can leave comments on what they were doing and what went wrong. #{can?(:request, :review_feedback) ? 'Feedback is anonymous.' : 'Feedback is anonymous and we’ve not removed spam.'}"
} %>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">By URL</h2>
  <%= form_for @explore_by_multiple_paths, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/input", {
      label: { text: "URL(s) (required)" },
      name: name_for(f, %w[list_of_urls]),
      value: f.object.list_of_urls,
      required: true,
      hint: sanitize(
        'For example a page like /vat-rates or https://www.gov.uk/bank-holidays, or a partial path like /guidance/
        <br/>
        You can also search by a comma separated list: /vat-rates, https://www.gov.uk/bank-holidays, /guidance/
        <br/>
        For longer lists, please upload a file with the comma separated list (see below in "Upload a URL List").'
      ),
      error_message: error_for(@explore.errors, :base)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by URL"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">Upload a URL List</h2>
  <%= form_for @explore_by_multiple_paths,
              url: { action: "create" },
              html: { multipart: true } do |f| %>
    <%= render "govuk_publishing_components/components/file_upload", {
      label: { text: "Upload list of URLs (required)" },
      name: name_for(f, %w[uploaded_list]),
      hint: sanitize(
        'The contents of the file should be a comma separated list:
        /vat-rates, https://www.gov.uk/bank-holidays, /guidance/'
      ),
      error_message: error_for(@explore.errors, :uploaded_list)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Upload list of urls"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">By organisation</h2>
  <%= form_for @explore_by_organisation, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/select", {
      label: "Organisation (required)",
      id: name_for(f, %w[organisation]),
      name: name_for(f, %w[organisation]),
      options: [{ text: "", value: "" }] + @organisations_list.map do |text, value|
        {
          text: text,
          value: value,
          selected: f.object.organisation == value
        }
      end,
      error_message: errors_for(f.object.errors, :organisation)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by organisation"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">By document type</h2>
  <%= form_for @explore_by_document_type, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/select", {
      label: "Document Type (required)",
      id: name_for(f, %w[document_type]),
      name: name_for(f, %w[document_type]),
      options: [{ text: "", value: "" }] + @document_type_list.map { |title, value|
        {
          text: title,
          value: value,
          selected: f.object.document_type == value
        }
      },
      error_message: errors_for(f.object.errors, :document_type)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by document type"
    } %>
  <% end %>
</div>

<% if can? :request, :global_export_request %>
  <div class="global-export-request govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Total quantity by day</h2>

    <%= form_tag anonymous_feedback_global_export_requests_path do %>
      <%= render "govuk_publishing_components/components/input", {
        label: { text: "Start date" },
        id: "from-date",
        name: "from_date",
        value: params[:from_date],
        width: 10,
        data: { module: "calendar", max_date: "0" }
      } %>

      <%= render "govuk_publishing_components/components/input", {
        label: { text: "End date" },
        id: "to-date",
        name: "to_date",
        value: params[:to_date],
        width: 10,
        data: { module: "calendar", max_date: "0" }
      } %>

      <%= render "govuk_publishing_components/components/checkboxes", {
        name: "exclude_spam",
        items: [
          {
            label: "Exclude requests marked as spam",
            value: 1,
            checked: true
          }
        ]
      } %>

      <%= render "govuk_publishing_components/components/button", {
        text: "Export as CSV"
      } %>
    <% end %>
  </div>
<% end %>

<% if can? :request, :review_feedback %>
  <div class="govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Review Anonymous Feedback for Spam</h2>

    <%= form_tag anonymous_feedback_problem_reports_path, method: :get do %>
      <%= render "govuk_publishing_components/components/button", {
        text: "Review Anonymous Feedback"
      } %>
    <% end %>
  </div>
<% end %>

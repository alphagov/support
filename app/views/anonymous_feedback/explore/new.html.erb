<%= content_for :page_title, "Anonymous Feedback" %>
<%= content_for :header, "Explore feedback from users" %>
<% url_form_submitted = @explore.is_a?(Support::Requests::Anonymous::ExploreByMultiplePaths) %>
<% upload_form_submitted = url_form_submitted && !@explore.uploaded_list.nil? %>
<% text_form_submitted = url_form_submitted && @explore.uploaded_list.nil? %>

<p class="govuk-body">
  On each page of the GOV.UK website, users are asked, “is there anything wrong with this page?”. Use this tool to explore the responses to this question.
</p>
<p class="govuk-body">
  You can find feedback by URL, organisation, or document type. Please note that, feedback is anonymous<%= can?(:request, :review_feedback) ? "." : " and spam hasn't been removed." %>
</p>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">Find feedback by URL</h2>
  <p class="govuk-body">Submit a single URL or multiple URLs to view feedback for them. For a large number of URLs, upload a file containing the comma separated paths.</p>
  <%= form_for @explore_by_multiple_paths, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/input", {
      label: { text: "URL(s) as text", bold: true },
      name: name_for(f, %w[list_of_urls]),
      value: f.object.list_of_urls,
      required: true,
      hint: "For example, a full path like https://www.gov.uk/bank-holidays, or a partial path like /guidance/. Multiple URLs should be comma separated.",
            error_items: errors_for(@explore&.errors, :list_of_urls) || (errors_for(@explore&.errors, :base) if text_form_submitted)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by URL"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <%= form_for @explore_by_multiple_paths,
              url: { action: "create" },
              html: { multipart: true } do |f| %>
    <%= f.hidden_field :uploaded_list, value: "" %>
    <%= render "govuk_publishing_components/components/file_upload", {
      label: { text: "URLs as a file", bold: true },
      name: name_for(f, %w[uploaded_list]),
      hint: "The file should contain a list of comma separated URLs",
      error_items: errors_for(@explore&.errors, :uploaded_list) || (errors_for(@explore&.errors, :base) if upload_form_submitted)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Upload"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">Find feedback by organisation</h2>
  <%= form_for @explore_by_organisation, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/select", {
      label: "Organisation",
      id: name_for(f, %w[organisation]),
      name: name_for(f, %w[organisation]),
      options: [{ text: "", value: "" }] + @organisations_list.map do |text, value|
        {
          text: text,
          value: value,
          selected: f.object.organisation == value
        }
      end,
      error_items: errors_for(@explore&.errors, :organisation)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by organisation"
    } %>
  <% end %>
</div>

<div class="govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-l">Find feedback by document type</h2>
  <%= form_for @explore_by_document_type, url: { action: "create" } do |f| %>
    <%= render "govuk_publishing_components/components/select", {
      label: "Document Type",
      id: name_for(f, %w[document_type]),
      name: name_for(f, %w[document_type]),
      options: [{ text: "", value: "" }] + @document_type_list.map { |title, value|
        {
          text: title,
          value: value,
          selected: f.object.document_type == value
        }
      },
      error_items: errors_for(@explore&.errors, :document_type)
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: "Explore by document type"
    } %>
  <% end %>
</div>

<% if can? :request, :global_export_request %>
  <div class="global-export-request govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Total quantity by day</h2>

    <%= form_tag anonymous_feedback_global_export_requests_path do %>
      <%= render "govuk_publishing_components/components/input", {
        label: { text: "Start date" },
        hint: "For example, 1 Aug 2016",
        id: "from-date",
        name: "from_date",
        value: params[:from_date],
        width: 10,
      } %>

      <%= render "govuk_publishing_components/components/input", {
        label: { text: "End date" },
        hint: "For example, 1 Aug 2016",
        id: "to-date",
        name: "to_date",
        value: params[:to_date],
        width: 10,
      } %>

      <%= render "govuk_publishing_components/components/checkboxes", {
        name: "exclude_spam",
        items: [
          {
            label: "Exclude requests marked as spam",
            value: 1,
            checked: true
          }
        ]
      } %>

      <%= render "govuk_publishing_components/components/button", {
        text: "Export as CSV"
      } %>
    <% end %>
  </div>
<% end %>

<% if can? :request, :review_feedback %>
  <div class="govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Review Anonymous Feedback for Spam</h2>

    <%= form_tag anonymous_feedback_problem_reports_path, method: :get do %>
      <%= render "govuk_publishing_components/components/button", {
        text: "Review Anonymous Feedback"
      } %>
    <% end %>
  </div>
<% end %>

<p class="govuk-body"><%= f.object.class.description %></p>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "Name of topic you'd like changed (required)" },
  name: name_for(f, %w[title]),
  value: f.object.title,
  error_items: errors_for(@request.errors, :title)
} %>

<%= render "govuk_publishing_components/components/radio", {
  heading: "What would you like to change? (required)",
  heading_level: 0,
  name: name_for(f, %w[type_of_change]),
  items: f.object.type_of_change_options.map do |text, value|
    {
      text: text,
      value: value,
      checked: f.object.type_of_change == value
    }
  end,
  error_items: errors_for(@request.errors, :type_of_change)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Please give details of how you'd like the topic changed (required)" },
  name: name_for(f, %w[details]),
  value: f.object.details,
  rows: 6,
  error_items: errors_for(@request.errors, :details)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Why do you think this change is needed? Please provide any evidence you have (required)" },
  name: name_for(f, %w[reasons]),
  value: f.object.reasons,
  rows: 6,
  error_items: errors_for(@request.errors, :reasons)
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<%= content_for :page_title, @request.class.label %>
<%= content_for :header, @request.class.label %>

<% breadcrumb :request, @request %>

<%= form_for @request, url: { action: "create" }, html: { novalidate: false } do |f| %>
  <%= render partial: "request_details", locals: { f: f } %>

  <%= render "govuk_publishing_components/components/button", {
    text: "Submit"
  } %>
<% end %>

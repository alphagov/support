<%= f.fields_for :time_constraint do |r| %>
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
      Are there any time constraints? (Optional)
    </legend>

    <%= render "govuk_publishing_components/components/date_input", {
      legend_text: "Deadline",
      hint: "For example, 27 3 2007",
      items: [
        {
          label: "Day",
          name: name_for(r, %w[needed_by_day]),
          id: "needed-by-day",
          width: 2
        },
        {
          label: "Month",
          name: name_for(r, %w[needed_by_month]),
          id: "needed-by-month",
          width: 2
        },
        {
          label: "Year",
          name: name_for(r, %w[needed_by_year]),
          id: "needed-by-year",
          width: 4
        }
      ],
      error_items: errors_for(@request.errors, :needed_by_date)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Time this must be published by" },
      name: name_for(r, %w[needed_by_time]),
      type: "time",
      value: r.object.needed_by_time,
      width: 10,
      error_items: errors_for(@request.errors, :needed_by_time)
    } %>

    <%= render "govuk_publishing_components/components/date_input", {
      legend_text: "Must not be published before",
      hint: "For example, 27 3 2007",
      items: [
        {
          label: "Day",
          name: name_for(r, %w[not_before_day]),
          id: "not-before-day",
          width: 2
        },
        {
          label: "Month",
          name: name_for(r, %w[not_before_month]),
          id: "not-before-month",
          width: 2
        },
        {
          label: "Year",
          name: name_for(r, %w[not_before_year]),
          id: "not-before-year",
          width: 4
        }
      ],
      error_items: errors_for(@request.errors, :not_before_date)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Time this must not be published before" },
      name: name_for(r, %w[not_before_time]),
      type: "time",
      value: r.object.not_before_time,
      width: 10,
      error_items: errors_for(@request.errors, :not_before_time)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Reason for deadline" },
      hint: "For example, policy or campaign launch, start of the new tax year.",
      name: name_for(r, %w[time_constraint_reason]),
      value: r.object.time_constraint_reason,
      error_items: errors_for(@request.errors, :time_constraint_reason)
    } %>
  </fieldset>
<% end %>

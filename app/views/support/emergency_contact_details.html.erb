<%= content_for :page_title, "Emergency contact details" %>
<%= content_for :header, "GOV.UK emergency contact details" %>

<%= render "govuk_publishing_components/components/inset_text", {} do %>
  <p class="govuk-body">
    First read the guidance on
    <%= link_to "publishing procedures for national emergencies",
      "https://www.gov.uk/guidance/contact-the-government-digital-service/gov-uk-support-requests-processes-and-response-times",
      class: "govuk-link"
    %>
    and
    <%= link_to "GOV.UK contact procedures",
      "https://www.gov.uk/guidance/contact-the-government-digital-service/how-to-contact-gds",
      class: "govuk-link"
    %>.
  </p>
<% end %>

<section class="govuk-!-margin-top-6">
  <p class="govuk-body">What you need to do depends on whether you want to:</p>
  <ul class="govuk-list govuk-list--bullet">
    <li><%= link_to "request a change to GOV.UK content", { anchor: "request-change" }, class: "govuk-link" %></li>
    <li><%= link_to "report a major technical problem", { anchor: "report-problem" }, class: "govuk-link" %></li>
    <li><%= link_to "update GOV.UK following a national emergency", { anchor: "national-emergency" }, class: "govuk-link" %></li>
    <li><%= link_to "get help with GOV.UK Verify", { anchor: "govuk-verify" }, class: "govuk-link" %></li>
  </ul>
</section>

<section class="govuk-!-margin-top-8 govuk-!-margin-bottom-8">
  <h2 id="request-change" class="govuk-heading-l">Request a change to GOV.UK content</h2>

  <p class="govuk-body">
    Before you contact us, you must first
    <%= link_to "submit a support request", new_content_change_request_path, class: "govuk-link" %>.
  </p>
  <p class="govuk-body">After that, check whether your request counts as an emergency:</p>
  <ul class="govuk-list govuk-list--bullet">
    <li><%= link_to "read about what counts as an emergency change for 'mainstream' content", "https://guidance.publishing.service.gov.uk/accounts-support/make-content-requests/ask-updates-content/#if-you-need-emergency-support", class: "govuk-link" %></li>
    <li><%= link_to "read about what counts as an emergency change for other GOV.UK content", "https://guidance.publishing.service.gov.uk/accounts-support/get-content-advice/get-help-advice/#emergency-support-for-publishing-requests", class: "govuk-link" %></li>
  </ul>
  <p class="govuk-body">If your request is not an emergency, you can flag it as 'URGENT' in the title of the request and it will be picked up as soon as possible in office hours.</p>
  <p class="govuk-body">If your request is an emergency, the way you contact us depends on whether you are calling within office hours.</p>
  <p class="govuk-body">Both contact methods will put you in contact with a member of the GOV.UK content team.</p>

  <h3 class="govuk-heading-m">Office hours (Monday to Friday, 9am to 6pm)</h3>
  <p class="govuk-body">Use only if either:</p>
  <ul class="govuk-list govuk-list--bullet">
    <li>you’re unable to publish at a critical time</li>
    <li>you need to make emergency changes to government content managed by GDS</li>
  </ul>

  <p class="govuk-body govuk-!-margin-bottom-0">
    <%= mail_to @primary_contact_details[:content_emergency][:email], nil, class: "govuk-link" %>
  </p>
  <p class="govuk-body">Monday to Friday, 9am to 6pm<br>(excluding bank holidays)</p>

  <h3 class="govuk-heading-m">Outside office hours, including bank holidays</h3>
  <p class="govuk-body">Use only if the public or government is facing immediate and significant financial, legal or physical risk.</p>
  <p class="govuk-body">Leave a message and a contact number if the phone is not answered – please do not text.</p>

  <p class="govuk-body govuk-!-margin-bottom-0">
    <%= @primary_contact_details[:urgent_mainstream_content_change][:phone] %>
  </p>
  <p class="govuk-body">Monday to Friday, 6pm to 9am<br>Weekends and bank holidays, 24 hours</p>
</section>

<section class="govuk-!-margin-top-8 govuk-!-margin-bottom-8">
  <h2 id="report-problem" class="govuk-heading-l">
    Report a major technical problem with GOV.UK
  </h2>

  <p class="govuk-body">
    Use only for critical, high-profile technical issues with the GOV.UK site - such as pages not loading or search not working. Before reporting a problem, please check
    <%= link_to "the GOV.UK status page", "https://status.publishing.service.gov.uk/", class: "govuk-link" %>
    to see if the problem is already being dealt with.
  </p>

  <p class="govuk-body govuk-!-margin-bottom-0">
    <%= @primary_contact_details[:major_technical_problems][:phone] %>
  </p>
  <p class="govuk-body">24 hours, 7 days a week</p>

  <p class="govuk-body">
    This number will put you in contact with a member of the GOV.UK escalations team, who will advise on next steps.
  </p>
</section>

<section class="govuk-!-margin-top-8 govuk-!-margin-bottom-8">
  <h2 id="national-emergency" class="govuk-heading-l">
    Update GOV.UK following a national emergency
  </h2>

  <p class="govuk-body">Use only if both:</p>
  <ul class="govuk-list govuk-list--bullet">
    <li>there’s been a sudden, critical national emergency such as a terrorist attack</li>
    <li>you’re the communications coordinator in the lead crisis response department for sudden, critical national emergencies such as terrorist attacks</li>
  </ul>

  <p class="govuk-body govuk-!-margin-bottom-0">
    <%= @primary_contact_details[:national_emergencies][:phone] %>
  </p>
  <p class="govuk-body">24 hours, 7 days a week</p>

  <p class="govuk-body">
    This number will put you in contact with GOV.UK, who will establish your identity and put the GOV.UK site into ‘emergency’ mode.
  </p>
  <p class="govuk-body">
    Find out more about the
    <%= link_to "national emergency publishing process",
      "https://www.gov.uk/guidance/contact-the-government-digital-service/national-emergency-publishing-guidelines",
      class: "govuk-link"
    %>.
  </p>
</section>

<% if @secondary_contact_details %>
  <section class="govuk-!-margin-top-8 govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Backup contact</h2>
    <p class="govuk-body">If you cannot get through on the other numbers, you can call the Head of GOV.UK.</p>

    <div class="govuk-grid-row">
      <% @secondary_contact_details.each do |details| %>
        <div class="govuk-grid-column-one-half govuk-!-margin-bottom-6">
          <p class="govuk-body">
            <%= details[:name] %><br>
            <%= details[:role] %>
          </p>
          <p class="govuk-body govuk-!-margin-bottom-0">
            <%= mail_to details[:email], nil, class: "govuk-link" %>
          </p>
          <p class="govuk-body"><%= details[:phone] %></p>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="govuk-!-margin-top-8 govuk-!-margin-bottom-8">
  <h2 id="govuk-verify" class="govuk-heading-l">GOV.UK Verify contacts</h2>
  <h3 class="govuk-heading-m">Emergency support</h3>

  <p class="govuk-body">
    <%= link_to "Check the GOV.UK Verify status page",
      "https://verifystatus.digital.cabinet-office.gov.uk/",
      class: "govuk-link"
    %>
    to see if the issue has already been reported.
  </p>
  <p class="govuk-body">Out of hours GOV.UK Verify support</p>
  <p class="govuk-body">
    <%= mail_to @verify_contact_details[:out_of_hours_email], nil, class: "govuk-link" %>
  </p>
</section>

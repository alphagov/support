<%= render "govuk_publishing_components/components/notice", {
  title: f.object.class.description
} %>

<%= f.fields_for :live_campaign do |r| %>
  <%= render "govuk_publishing_components/components/fieldset", {
    legend_text: "Campaign details",
    heading_size: "m"
  } do %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Campaign title (required)" },
      name: name_for(r, %w[title]),
      value: r.object.title,
      width: 20,
      error_items: errors_for(r.object.errors, :title)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Campaign URL (required)" },
      name: name_for(r, %w[proposed_url]),
      value: r.object.proposed_url,
      width: 20,
      error_items: errors_for(r.object.errors, :proposed_url)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Details of requested support (required)" },
      name: name_for(r, %w[description]),
      value: r.object.description,
      rows: 6,
      error_items: errors_for(r.object.errors, :description)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Are there any time constraints for this request?" },
      name: name_for(r, %w[time_constraints]),
      value: r.object.time_constraints,
      width: 20,
      error_items: errors_for(r.object.errors, :time_constraints)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Reason for the above dates?" },
      name: name_for(r, %w[reason_for_dates]),
      value: r.object.reason_for_dates,
      rows: 6,
      error_items: errors_for(r.object.errors, :reason_for_dates)
    } %>
  <% end %>
<% end %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<% content_for :page_title, "Check your answers" %>

<%#= govuk_back_link href: @wizard.previous_step_path %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Check your answers</h1>

      <% @steps.each do |step| %>
        <dl class="govuk-summary-list">
          <% step.attributes.each do |label, value| %>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key"><%=step.class.human_attribute_name(label) %></dt>
              <dd class="govuk-summary-list__value">
                <% if value.is_a?(Date) %>
                  <%= value.to_fs('%d %B %Y') %>
                <% else %>
                  <%= Array(value).compact_blank.map(&:humanize).join(', ') %>
                <% end %>
              </dd>
              <dd class="govuk-summary-list__actions">
                <%= link_to("Change", @wizard.resolve_step_path(step.step_id, return_to_review: step.step_id) ) %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% end %>

    <%= button_to "Confirm and submit", content_advice_submission_path, method: :post, class: "govuk-button" %>
  </div>
</div>
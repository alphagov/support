<%= render "govuk_publishing_components/components/notice", {
  title: "Content Data is in beta. It is currently operating in a minimal maintenance mode only,
  so no further product developments are planned. Our capacity for addressing any issues
  that arise is also limited, so only those with a significant impact can be prioritised."
} %>

<div id="feedback-type">
  <%= render "govuk_publishing_components/components/radio", {
    heading: "Your feedback is about (required)",
    heading_level: 0,
    name: name_for(f, %w[feedback_type]),
    items: f.object.feedback_type_options.map do |text, value|
      {
        text: text,
        value: value,
        checked: f.object.feedback_type == value
      }
    end,
    error_items: errors_for(@request.errors, :feedback_type)
  } %>

  <%= render "govuk_publishing_components/components/textarea", {
    label: { text: "Tell us a bit more (required)" },
    name: name_for(f, %w[feedback_details]),
    value: f.object.feedback_details,
    rows: 6,
    error_items: errors_for(@request.errors, :feedback_details)
  } %>

  <%= render "govuk_publishing_components/components/textarea", {
    label: { text: "What's the impact on your work if we don't do anything about it? (required)" },
    hint: "This information will help us prioritise changes and future work",
    name: name_for(f, %w[impact_on_work]),
    value: f.object.impact_on_work,
    rows: 6,
    error_items: errors_for(@request.errors, :impact_on_work)
  } %>
</div>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "To add screenshots to this feedback, reply to the acknowledgement email you receive and attach them."
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

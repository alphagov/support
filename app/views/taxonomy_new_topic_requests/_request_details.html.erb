<%= render "govuk_publishing_components/components/notice", {
  title: f.object.class.description.html_safe
} %>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "Preferred name of new topic (required)" },
  name: name_for(f, %w[title]),
  value: f.object.title,
  error_items: errors_for(@request.errors, :title)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "URL(s) of page(s) you want to tag to this topic (provide as many as you can) (required)" },
  name: name_for(f, %w[url]),
  value: f.object.url,
  hint: "https://www.gov.uk/government/...",
  rows: 6,
  error_items: errors_for(@request.errors, :url)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Why do you think this new topic is needed? Please provide any evidence you have (required)" },
  name: name_for(f, %w[details]),
  value: f.object.details,
  rows: 6,
  error_items: errors_for(@request.errors, :details)
} %>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "Where should this topic fit in the topic taxonomy? For example, a subtopic of Early years curriculum (required)" },
  name: name_for(f, %w[parent]),
  value: f.object.parent,
  error_items: errors_for(@request.errors, :parent)
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<%= hidden_field_tag "use_design_system", true %>
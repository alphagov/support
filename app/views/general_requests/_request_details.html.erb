<p class="govuk-body">Please use this path to:</p>
<ul class="govuk-list govuk-list--bullet">
  <li>report planned departmental changes that affect GOV.UK and its users</li>
  <li>report issues that don't fit into other categories</li>
</ul>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "Title of request" },
  hint: "General request",
  name: name_for(f, %w[title]),
  error_items: errors_for(@request.errors, :title)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Details (required)" },
  name: name_for(f, %w[details]),
  error_items: errors_for(@request.errors, :details)
} %>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "URL (if applicable)" },
  name: name_for(f, %w[url]),
  error_items: errors_for(@request.errors, :url)
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

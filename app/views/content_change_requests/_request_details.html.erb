<%= render "govuk_publishing_components/components/notice", {
  description: sanitize('<p class="govuk-body">You\'ll get an automated response to confirm we\'ve received your request. We\'ll then review your request within 2 working days.</p><p class="govuk-body"><a class="govuk-link" href="https://guidance.publishing.service.gov.uk/accounts-support/make-content-requests/ask-updates-content">How to write a request that will get resolved quickly</a>.</p>'),
} %>

<%= render "govuk_publishing_components/components/input", {
  label: {
    text: "Title of request (required)"
  },
  hint: "Clearly summarise what needs to change - for example, ‘Update phone numbers in Universal Credit guide’ or ‘Create a start page for clean air zones’.",
  name: name_for(f, %w[title]),
  value: f.object.title,
  error_items: errors_for(@request.errors, :title)
} %>

<%= render "govuk_publishing_components/components/select", {
  label: "What’s the reason for the request? (required)",
  hint: "If none of the options below are appropriate, please select other.",
  id: name_for(f, %w[reason_for_change]),
  options: [{ text: "", value: "" }] + f.object.reason_for_change_options.map do |option|
    {
      text: option,
      value: option,
      selected: f.object.reason_for_change == option
    }
  end,
  error_items: errors_for(@request.errors, :reason_for_change)
} %>

<%= render "govuk_publishing_components/components/select", {
  label: "What’s the subject area? (required)",
  hint: "If your request covers multiple subject areas, choose the one you think most relevant.",
  id: name_for(f, %w[subject_area]),
  options: [{ text: "", value: "" }] + f.object.subject_area_options.map do |option|
    {
      text: option,
      value: option,
      selected: f.object.subject_area == option
    }
  end,
  error_items: errors_for(@request.errors, :subject_area)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "Which URLs are affected? (required)"
  },
  hint: "List URLs, one per line. Include any Welsh URLs where translations are needed.",
  name: name_for(f, %w[url]),
  value: f.object.url,
  error_items: errors_for(@request.errors, :url)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "Tell us about the content that needs to be created, updated or is causing a problem for users? (required)"
  },
  hint: sanitize(
    '<p>Make sure you:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>include evidence of why this is a problem, for example, user feedback or call centre data</li>
      <li>give sufficient detail</li>
      <li>use plain English</li>
      <li>explain any acronyms, jargon or legal language</li>
      <li>say which parts of the content are affected, for example, the first paragraph of the overview</li>
      <li>separate different points, for example, by numbering them</li>
    </ul>
    <p>If you send us wording, we might not use it. If we do, we’ll need to put it in GOV.UK style.</p>'
  ),
  name: name_for(f, %w[details_of_change]),
  value: f.object.details_of_change,
  error_items: errors_for(@request.errors, :details_of_change)
} %>

<%= render "govuk_publishing_components/components/notice", {
  description: sanitize(
    '<p class="govuk-body">If you have relevant supporting documents, or files for us to host, please send them as attachments in reply to the acknowledgement email you will receive shortly.</p>'
  ),
} %>

<%= render partial: "support/time_constraint", locals: { f: f } %>

<%= render "govuk_publishing_components/components/notice", {
  description: sanitize(
    '<p class="govuk-body"><strong>If your request is urgent</strong></p>' \
    '<p class="govuk-body">Submit this form and ' \
    "#{link_to 'use one of our emergency contact methods (opens in new tab)', emergency_contact_details_path, target: '_blank'}." \
    '</p>' \
    '<p class="govuk-body">It’s urgent only if the public or the government faces immediate and significant financial, legal or physical risk.</p>'
  ),
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "Changes and new features need to be assessed against the GOV.UK roadmap. Give as much detail as you can about the user need and evidence for your request."
} %>

<%= render "govuk_publishing_components/components/input", {
  label: { text: "Title of request" },
  name: name_for(f, %w[title]),
  value: f.object.title,
  hint: "New need request",
  error_items: errors_for(@request.errors, :title)
} %>

<%= render "govuk_publishing_components/components/fieldset", {
  legend_text: "Details of the new feature/need",
  heading_size: "m"
} do %>
  <%= render "govuk_publishing_components/components/textarea", {
    label: {
      text: "What is the product request or technical advice you need? (required)"
    },
    name: name_for(f, %w[user_need]),
    value: f.object.user_need,
    rows: 6,
    error_items: errors_for(@request.errors, :user_need)
  } %>

  <%= render "govuk_publishing_components/components/textarea", {
    label: {
      text: "If this is a request for a new feature, what evidence do you have to support the request?"
    },
    name: name_for(f, %w[feature_evidence]),
    value: f.object.feature_evidence,
    rows: 6,
    error_items: errors_for(@request.errors, :feature_evidence)
  } %>
<% end %>

<%= render partial: "support/attachment_instructions" %>

<%= render partial: "support/collaborators", locals: { f: f } %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "Please make a separate request for each target redirect.",
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "Whitehall or Content Publisher URL of the page to be unpublished (required)"
  },
  hint: "You can specify more than one URL, as long as it's clear where each URL should be redirected.",
  name: name_for(f, %w[urls]),
  value: f.object.urls,
  rows: 6,
  error_items: errors_for(@request.errors, :urls)
} %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "You may also wish to send this information in a spreadsheet, by attaching it to the Zendesk confirmation email."
} %>

<%= render "govuk_publishing_components/components/radio", {
  id: "unpublish-reason",
  heading: "What is the reason for unpublishing? (required)",
  heading_level: 0,
  name: name_for(f, %w[reason_for_unpublishing]),
  items: f.object.reason_for_unpublishing_options.map do |text, value|
    {
      value: value,
      text: text,
      checked: f.object.reason_for_unpublishing == value
    }
  end,
  error_items: errors_for(@request.errors, :reason_for_unpublishing)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: {
    text: "Redirects will be automatic unless you give a reason:"
  },
  name: name_for(f, %w[further_explanation]),
  value: f.object.further_explanation,
  rows: 6,
  error_items: errors_for(@request.errors, :further_explanation)
} %>

<p class="govuk-body">
  If you do give a reason, users will go to a landing page and read your reason,
  then click on the redirect URL. Note that:
</p>
<ul>
  <li>
    it is essential to write some text if the redirect is to the National
    Archives or an external website;
  </li>
  <li>
    you should always give an explanation for users if a page is being deleted
    with no redirect, and is not likely to be republished.
  </li>
</ul>

<%= render "govuk_publishing_components/components/fieldset", {
  legend_text: "Redirect details (optional if published in error)",
  heading_size: "m",
} do %>
  <%= render "govuk_publishing_components/components/input", {
    label: { text: "Redirect URL" },
    hint: "We need the GOV.UK page for the redirect URL",
    name: name_for(f, %w[redirect_url]),
    value: f.object.redirect_url,
    error_items: errors_for(@request.errors, :redirect_url)
  } %>

  <%= render "govuk_publishing_components/components/checkboxes", {
    name: name_for(f, %w[automatic_redirect]),
    items: [
      {
        label: "Redirect to URL automatically?",
        value: "1",
        checked: f.object.automatic_redirect == "1"
      }
    ]
  } %>
<% end %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "This page will be unpublished (it will revert to draft). You will be notified when this is done and it is then your responsibility to delete this page or re-publish it in due course."
} %>

<%= render "govuk_publishing_components/components/error_alert", {
  message: "Pages cannot be recovered once you have deleted them. Please ensure that all requests to GDS to unpublish content have been approved at the correct level in your organisation - if you aren't sure check with your GDS single point of contact."
} %>

<%= render partial: "support/collaborators", locals: { f: f } %>

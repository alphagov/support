<% if @request.errors[:base].present? %>
  <%= render "govuk_publishing_components/components/error_alert", {
    message: @request.errors[:base].first
  } %>
<% end %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "Only department/organisation Analytics Single Point of Contact (SPOC) can request access."
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Access to Google Analytics" },
  name: name_for(f, %w[google_analytics_request_details]),
  hint: "Detail full name, email address and areas of content.",
  value: f.object.google_analytics_request_details,
  rows: 6,
  error_items: errors_for(@request.errors, :google_analytics_request_details)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Tell me who my Analytics Single Point of Contact (SPOC) is" },
  name: name_for(f, %w[single_point_of_contact_request_details]),
  value: f.object.single_point_of_contact_request_details,
  hint: "Detail information on department/organisation/agency. If you have one include your parent or sponsoring department.",
  rows: 6,
  error_items: errors_for(@request.errors, :single_point_of_contact_request_details)
} %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "GDS no longer provide basic analytic reports - you should contact your department/organisation Analytics Single Point of Contact (SPOC) for analytic reporting."
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Analytics Report Request" },
  name: name_for(f, %w[report_request_details]),
  value: f.object.report_request_details,
  hint: "Detail of report including date range.",
  rows: 6,
  error_items: errors_for(@request.errors, :report_request_details)
} %>

<%= render "govuk_publishing_components/components/inset_text", {
  text: "Before contacting the GDS performance analytics team please check the GOV.UK Performance Analytics Basecamp community for tips or post your query there for help."
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Analytics Help" },
  name: name_for(f, %w[help_request_details]),
  value: f.object.help_request_details,
  hint: "Detail what help you require and be specific in the examples you submit.",
  rows: 6,
  error_items: errors_for(@request.errors, :help_request_details)
} %>

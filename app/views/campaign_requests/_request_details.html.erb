<%= render "govuk_publishing_components/components/notice", {
  title: f.object.class.description
} %>

<p class="govuk-body">
  Use this for: A single or multi page site on the GOV.UK Campaigns Platform
</p>

<p class="govuk-body">
  Please answer the questions below.
</p>

<%= f.fields_for :campaign do |r| %>
  <%= render "govuk_publishing_components/components/fieldset", {
    legend_text: "Campaign details",
    heading_size: "m"
  } do %>

    <%= render "govuk_publishing_components/components/checkboxes", {
      name: name_for(r, %w[has_read_guidance_confirmation]),
      items: [
        {
          label: safe_join([
            "I/We have read the ",
            link_to(
              "GCS guidance on campaign websites",
              "https://www.communications.gov.uk/publication/how-to-set-up-a-government-campaign-website/"
            ),
            " and accept the requirements for a Campaign Platform website"
          ]),
          value: "Yes",
          checked: r.object.has_read_guidance_confirmation == "Yes"
        }
      ]
    } %>

    <%= render "govuk_publishing_components/components/checkboxes", {
      name: name_for(r, %w[has_read_oasis_guidance_confirmation]),
      items: [
        {
          label: safe_join([
            "I/We have followed the ",
            link_to(
              "GCS guidance for OASIS planning",
              "https://www.communications.gov.uk/publication/oasis-planning-government-communications/"
            ),
            " and are using the ",
            link_to(
              "mandatory GCS OASIS template",
              "https://gcs.civilservice.gov.uk/guidance/marketing/delivering-government-campaigns/guide-to-campaign-planning-oasis/"
            )
          ]),
          value: "Yes",
          checked: r.object.has_read_oasis_guidance_confirmation == "Yes"
        }
      ]
    } %>

    <%= render "govuk_publishing_components/components/checkboxes", {
      name: name_for(r, %w[full_responsibility_confirmation]),
      items: [
        {
          label: "I/We will take full responsibility for all aspects of managing and resourcing this campaign site from Discovery stage to site build/content development, to site closure. The site must be regularly reviewed to ensure a high standard of work. GCS reserves the right to close the site if standard of the site drops below expectations.",
          value: "Yes",
          checked: r.object.full_responsibility_confirmation == "Yes"
        }
      ]
    } %>

    <%= render "govuk_publishing_components/components/checkboxes", {
      name: name_for(r, %w[accessibility_confirmation]),
      items: [
        {
          label: safe_join([
            "I/We will ensure the site meets all ",
            link_to(
              "government web accessibility standards",
              "https://www.gov.uk/guidance/accessibility-requirements-for-public-sector-websites-and-apps"
            ),
            ", and that it will be tested and the Accessibility Statement completed before final review (if your team doesn't have expertise in accessible content design then appropriate training must be undertaken before the site build.)"
          ]),
          value: "Yes",
          checked: r.object.accessibility_confirmation == "Yes"
        }
      ]
    } %>

    <%= render "govuk_publishing_components/components/checkboxes", {
      name: name_for(r, %w[cookie_and_privacy_notice_confirmation]),
      items: [
        {
          label: 'I/We agree to take responsibility to maintain and up-date the Cookie Notice and Privacy Notice as necessary, with our Data Protection Officer (NB : GDS will add a basic "boilerplate", however departments will need to identify if additions are needed).',
          value: "Yes",
          checked: r.object.cookie_and_privacy_notice_confirmation == "Yes"
        }
      ]
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: {
        text: "Name of the Head of Digital Communications who signed off the campaign website application (required)"
      },
      name: name_for(r, %w[signed_campaign]),
      value: r.object.signed_campaign,
      width: 20,
      error_items: errors_for(r.object.errors, :signed_campaign)
    } %>

    <%= render "govuk_publishing_components/components/date_input", {
      legend_text: "Start date of campaign site (required)",
      hint: "For example, 27 3 2007",
      items: [
        {
          label: "Day",
          name: name_for(r, %w[start_day]),
          value: r.object.start_day,
          id: "start-day",
          width: 2
        },
        {
          label: "Month",
          name: name_for(r, %w[start_month]),
          value: r.object.start_month,
          id: "start-month",
          width: 2
        },
        {
          label: "Year",
          name: name_for(r, %w[start_year]),
          value: r.object.start_year,
          id: "start-year",
          width: 4
        }
      ],
      error_items: errors_for(r.object.errors, :start_date)
    } %>

    <p class="govuk-body">
      Once your site is live, you should allow time for testing before driving traffic to it.
      We advise leaving 1-2 days for no-cost campaigns, and at least a week for paid advertising campaigns.
    </p>

    <%= render "govuk_publishing_components/components/date_input", {
      legend_text: "Proposed end date of campaign site (required)",
      hint: "For example, 27 3 2007",
      items: [
        {
          label: "Day",
          name: name_for(r, %w[end_day]),
          value: r.object.end_day,
          id: "end-day",
          width: 2
        },
        {
          label: "Month",
          name: name_for(r, %w[end_month]),
          value: r.object.end_month,
          id: "end-month",
          width: 2
        },
        {
          label: "Year",
          name: name_for(r, %w[end_year]),
          value: r.object.end_year,
          id: "end-year",
          width: 4
        }
      ],
      error_items: errors_for(r.object.errors, :end_date)
    } %>

    <%= render "govuk_publishing_components/components/date_input", {
      legend_text: "Site build to commence on (required)",
      hint: "For example, 27 3 2007",
      items: [
        {
          label: "Day",
          name: name_for(r, %w[development_start_day]),
          value: r.object.development_start_day,
          id: "development-start-day",
          width: 2
        },
        {
          label: "Month",
          name: name_for(r, %w[development_start_month]),
          value: r.object.development_start_month,
          id: "development-start-month",
          width: 2
        },
        {
          label: "Year",
          name: name_for(r, %w[development_start_year]),
          value: r.object.development_start_year,
          id: "development-start-year",
          width: 4
        }
      ],
      error_items: errors_for(r.object.errors, :development_start_date)
    } %>

    <p class="govuk-body">
      We expect the website to go live within 1 month of approval.
    </p>

    <%= render "govuk_publishing_components/components/input", {
      label: {
        text: "Contact email/s for website performance review every 6 months (required)"
      },
      hint: "Every 6 months after your site goes live you will be required to provide performance data for the site based on your digital KPIs.",
      name: name_for(r, %w[performance_review_contact_email]),
      value: r.object.performance_review_contact_email,
      width: 20,
      error_items: errors_for(r.object.errors, :performance_review_contact_email)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: {
        text: "Which of the current Government Communications Plan priority themes does this campaign website support and how? (required)"
      },
      name: name_for(r, %w[government_theme]),
      value: r.object.government_theme,
      rows: 6,
      error_items: errors_for(r.object.errors, :government_theme)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Site title (required)" },
      hint: "The short campaign title, as appears in (for example) Google Search. 2-3 words",
      name: name_for(r, %w[site_title]),
      value: r.object.site_title,
      width: 20,
      error_items: errors_for(r.object.errors, :site_title)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Site tagline (required)" },
      hint: "Explain what this site is about, as appears in (for example) Google Search. Maximum 7-8 words",
      name: name_for(r, %w[site_tagline]),
      value: r.object.site_tagline,
      width: 20,
      error_items: errors_for(r.object.errors, :site_tagline)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Site metadescription (appears in search results) (required)" },
      hint: "Approx 20-30 words, as appears in (for example) Google Search",
      name: name_for(r, %w[site_metadescription]),
      value: r.object.site_metadescription,
      rows: 6,
      error_items: errors_for(r.object.errors, :site_metadescription)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Campaign description (required)" },
      name: name_for(r, %w[description]),
      value: r.object.description,
      rows: 6,
      error_items: errors_for(r.object.errors, :description)
    } %>

    <%= render "govuk_publishing_components/components/textarea", {
      label: { text: "Call to action (required)" },
      name: name_for(r, %w[call_to_action]),
      value: r.object.call_to_action,
      rows: 6,
      error_items: errors_for(r.object.errors, :call_to_action)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Proposed URL (in the form of xxxxx.campaign.gov.uk) (required)" },
      name: name_for(r, %w[proposed_url]),
      value: r.object.proposed_url,
      width: 20,
      error_items: errors_for(r.object.errors, :proposed_url)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Site build budget / costs (and overall campaign cost, if applicable) (required)" },
      name: name_for(r, %w[cost_of_campaign]),
      value: r.object.cost_of_campaign,
      width: 20,
      error_items: errors_for(r.object.errors, :cost_of_campaign)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "HMG code: from approved AMC technical cases. Format: HMGXX-XXX (If not applicable enter n/a)" },
      name: name_for(r, %w[hmg_code]),
      value: r.object.hmg_code,
      width: 20,
      error_items: errors_for(r.object.errors, :hmg_code)
    } %>

    <%= render "govuk_publishing_components/components/input", {
      label: { text: "Strategic Planning Code: from strategic planning phase. Format: CSBXX-XXX (If not applicable enter n/a)" },
      name: name_for(r, %w[strategic_planning_code]),
      value: r.object.strategic_planning_code,
      width: 20,
      error_items: errors_for(r.object.errors, :strategic_planning_code)
    } %>

  <% end %>
<% end %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "Additional comments (required)" },
  name: name_for(f, %w[additional_comments]),
  value: f.object.additional_comments,
  rows: 6,
  error_items: errors_for(@request.errors, :additional_comments)
} %>

<p class="govuk-body">
  Please note that in the next stage you will also need to provide an OASIS plan using this template
  (<%= link_to "OASIS template from the GCS website", "https://gcs.civilservice.gov.uk/guidance/campaigns/strategy-planning-templates/" %>).
  In particular you need to demonstrate how the digital / website element of the campaign integrates
  into your overall OASIS plan and we will need to see <u>specific digital KPIs</u> in the evaluation section.
</p>

<p class="govuk-body">GOV.UK site search learns from how people use it, so search results change and improve over time. However, there may be occasions where we need to step in to make sure certain pages appear higher or lower in results.</p>
<p class="govuk-body">Use this form to tell the GOV.UK search team about issues with search results that are stopping users finding what they need. For example:</p>
<ul class="govuk-list govuk-list--bullet">
  <li>pages that should appear at the top of search results but are too low</li>
  <li>pages not appearing in search results at all</li>
</ul>
<p class="govuk-body">We’ll review your request and may contact you for more information. Requests are prioritised based on user impact and severity.</p>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "What search queries are not working well? (required)" },
  hint: "Include the exact words users type into search. You can include more than one query (for example: universal credit payment, UC payment).",
  name: name_for(f, %w[search_query]),
  value: f.object.search_query,
  rows: 6,
  error_items: errors_for(@request.errors, :search_query)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "What is the problem with the search results? (required)" },
  name: name_for(f, %w[results_problem]),
  value: f.object.results_problem,
  rows: 6,
  error_items: errors_for(@request.errors, :results_problem)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "If applicable, which pages are missing, or showing too high or low in results? If the pages are showing do you think they should be higher, lower, or removed?" },
  hint: "Please include the URLs or pages.",
  name: name_for(f, %w[change_requested]),
  value: f.object.change_requested,
  rows: 6,
  error_items: errors_for(@request.errors, :change_requested)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "If applicable, explain why this change is necessary. Why are the current search results bad for users?" },
  name: name_for(f, %w[change_justification]),
  value: f.object.change_justification,
  rows: 6,
  error_items: errors_for(@request.errors, :change_justification)
} %>

<%= render "govuk_publishing_components/components/radio", {
  heading: "Is there evidence that users are searching for these queries? (required)",
  heading_level: 0,
  name: name_for(f, %w[evidence_availability]),
  items: f.object.evidence_availability_options.map do |text, value|
    {
      value: value,
      text: text,
      checked: f.object.evidence_availability == value
    }
  end,
  error_items: errors_for(@request.errors, :evidence_availability)
} %>

<%= render "govuk_publishing_components/components/textarea", {
  label: { text: "If applicable, summarise the evidence that users are searching for these queries." },
  name: name_for(f, %w[evidence_description]),
  value: f.object.evidence_description,
  rows: 6,
  error_items: errors_for(@request.errors, :evidence_description)
} %>

<%= hidden_field_tag "use_design_system", true %>
